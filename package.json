{
  "name": "taws",
  "version": "0.2.0",
  "description": "Tech Axel Web Surfer",
  "author": {
    "name": "Tech Axel",
    "email": "roberevan224@gmail.com"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --linux AppImage deb"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.techaxel.taws",
    "productName": "TAWS",
    "executableName": "taws",
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Network;WebBrowser;",
      "maintainer": "Tech Axel <roberevan224@gmail.com>",
      "desktopName": "taws",
      "synopsis": "Tech Axel Web Surfer",
      "icon": "assets/taws.svg"
    },
    "appImage": {
      "artifactName": "TAWS-${version}-${arch}.AppImage"
    },
    "deb": {
      "artifactName": "TAWS-${version}-${arch}.deb"
    }
  }
}
