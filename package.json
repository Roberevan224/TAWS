{
  "name": "taws",
  "version": "0.2.1",
  "description": "Tech Axel Web Surfer",
  "author": {
    "name": "Tech Axel",
    "email": "roberevan224@gmail.com"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --linux AppImage"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.techaxel.taws",
    "productName": "TAWS",
    "executableName": "taws",
    "linux": {
      "target": ["AppImage"],
      "category": "Network",
      "icon": "assets/taws.svg"
    },
    "appImage": {
      "artifactName": "TAWS-${version}-${arch}.AppImage"
    }
  }
}
